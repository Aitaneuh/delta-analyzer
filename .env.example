# Local development: copy this file to .env. In Portainer, set these under "Environment variables".

# Database
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Only for local development. docker-compose.yml builds this automatically in production.
DATABASE_URL=postgres://delta:delta@localhost:5432/delta

# The address visitors use, with no trailing slash. Must be https in production.
PUBLIC_URL=http://localhost:5173
APP_PORT=3000
# Number of reverse proxies in front of the app
TRUST_PROXY_HOPS=1

# Shown on the legal pages. Required in production.
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
HOSTING_COUNTRY=Switzerland
GOVERNING_LAW=Switzerland
SOURCE_CODE_URL=https://github.com/Aitaneuh/delta-analyzer
